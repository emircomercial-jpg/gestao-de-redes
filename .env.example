# Server
PORT=3000

# Redis (opcional, para BullMQ)
REDIS_URL=redis://localhost:6379

# Real AI provider (opcional)
REAL_AI_URL=https://api.example.com/v1/generate
REAL_AI_KEY=sk_your_key_here
REAL_AI_COST_PER_1K=0.12

# Meta (Facebook/Instagram) OAuth
META_REDIRECT_URI=http://localhost:3000/auth/meta/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# X (Twitter) callback
X_REDIRECT_URI=http://localhost:3000/auth/x/callback

# SMTP for alerts
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=supersecret

# Optional: enable model-based summaries to help compact prompts
USE_MODEL_SUMMARY=0
# Exemplo de variáveis de ambiente
PORT=3000
# URL de conexão Redis (para BullMQ). Se não fornecido, usa fallback em memória.
REDIS_URL=redis://localhost:6379

# Credenciais Meta (exemplo para testes)
#PAGE_ACCESS_TOKEN=your_page_access_token
#PAGE_ID=your_page_id

# Meta OAuth
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Redirect URI should point to /auth/meta/callback on your server
META_REDIRECT_URI=http://localhost:3000/auth/meta/callback
META_API_VERSION=v16.0

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback

# X (Twitter) OAuth
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=http://localhost:3000/auth/x/callback

# SMTP (opcional) - usado para envio de alertas por e-mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=changeme
ALERT_FROM=alerts@example.com
ALERT_TO=ops@example.com

# Real AI provider (opcional)
# If you provide REAL_AI_URL and REAL_AI_KEY, the server will try to call the real provider.
REAL_AI_URL=
REAL_AI_KEY=
REAL_AI_COST_PER_1K=0.10

# Enable model-based summarization for long prompts (reduces tokens). Set to 1 to enable.
USE_MODEL_SUMMARY=0
COMPACT_SUMMARY_THRESHOLD=3000
COMPACT_MAX_CHARS=1200

# Alerting defaults
ALERT_DEFAULT_BUDGET=100
