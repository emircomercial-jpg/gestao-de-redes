# Local .env para testes (não incluir chaves reais aqui)
PORT=3000
REDIS_URL=

# SMTP - deixar vazio para não enviar emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=alerts@example.com
ALERT_TO=ops@example.com

# Real AI provider (vazio = usa simulador)
REAL_AI_URL=
REAL_AI_KEY=
REAL_AI_COST_PER_1K=0.10

# Resumo automático para compactação via modelo (0 desliga)
USE_MODEL_SUMMARY=1
COMPACT_SUMMARY_THRESHOLD=3000
COMPACT_MAX_CHARS=1200

# Alerting defaults
ALERT_DEFAULT_BUDGET=100
